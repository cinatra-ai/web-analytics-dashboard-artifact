{
  "apiVersion": "v1.2",
  "scopeLevel": "organization",
  "portlets": [
    {
      "instanceId": "web-analytics-overview",
      "kind": "analytics",
      "version": "1.0.0",
      "slot": "fixed",
      "config": {
        "dashboard": {
          "portlets": [
            {
              "id": "wa-runs-kpi",
              "title": "Automation runs",
              "w": 3,
              "h": 6,
              "x": 0,
              "y": 0,
              "analysisConfig": {
                "version": 1,
                "analysisType": "query",
                "activeView": "chart",
                "charts": {
                  "query": {
                    "chartType": "kpiNumber",
                    "chartConfig": {
                      "yAxis": ["agent_runs.count"]
                    },
                    "displayConfig": {}
                  }
                },
                "query": {
                  "measures": ["agent_runs.count"]
                }
              }
            },
            {
              "id": "wa-content-by-type",
              "title": "Content items by type",
              "w": 9,
              "h": 8,
              "x": 3,
              "y": 0,
              "analysisConfig": {
                "version": 1,
                "analysisType": "query",
                "activeView": "chart",
                "charts": {
                  "query": {
                    "chartType": "bar",
                    "chartConfig": {
                      "xAxis": ["artifacts.type"],
                      "yAxis": ["artifacts.count"]
                    },
                    "displayConfig": {}
                  }
                },
                "query": {
                  "measures": ["artifacts.count"],
                  "dimensions": ["artifacts.type"],
                  "order": { "artifacts.count": "desc" },
                  "limit": 8
                }
              }
            },
            {
              "id": "wa-top-agents",
              "title": "Top agents by runs",
              "w": 6,
              "h": 8,
              "x": 0,
              "y": 8,
              "analysisConfig": {
                "version": 1,
                "analysisType": "query",
                "activeView": "table",
                "charts": {
                  "query": {
                    "chartType": "table",
                    "chartConfig": {},
                    "displayConfig": {}
                  }
                },
                "query": {
                  "measures": ["agent_runs.count"],
                  "dimensions": ["agent_runs.agent_name"],
                  "order": { "agent_runs.count": "desc" },
                  "limit": 5
                }
              }
            },
            {
              "id": "wa-model-usage",
              "title": "Model usage by events",
              "w": 6,
              "h": 8,
              "x": 6,
              "y": 8,
              "analysisConfig": {
                "version": 1,
                "analysisType": "query",
                "activeView": "table",
                "charts": {
                  "query": {
                    "chartType": "table",
                    "chartConfig": {},
                    "displayConfig": {}
                  }
                },
                "query": {
                  "measures": ["llm_usage.event_count"],
                  "dimensions": ["llm_usage.model"],
                  "order": { "llm_usage.event_count": "desc" },
                  "limit": 5
                }
              }
            }
          ],
          "layoutMode": "grid",
          "grid": { "cols": 12, "rowHeight": 50, "minW": 3, "minH": 4 }
        }
      }
    }
  ]
}
